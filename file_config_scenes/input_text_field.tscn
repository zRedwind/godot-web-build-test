[gd_scene format=3 uid="uid://c1h5l1hxe1rx2"]

[ext_resource type="Script" uid="uid://cpdwi2vd4tk1a" path="res://file_config_scenes/input_text_field.gd" id="1_ukgys"]

[sub_resource type="GDScript" id="GDScript_rvrdd"]
script/source = "extends LineEdit

func clear_field():
	text = \"\"
"

[sub_resource type="GDScript" id="GDScript_0xm2m"]
script/source = "extends Button

@export var input_text_field: LineEdit
@export var output_text: Label

signal submit_text(submitted_text: String)

func _on_pressed() -> void:
	var user_input = input_text_field.text
	if user_input == \"\":
		output_text.text = \"No text entered\"
	else:
		submit_text.emit(user_input)
		input_text_field.clear_field()
		output_text.text = \"Entered text: \" + user_input
"

